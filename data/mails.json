[
  {
    "id": "mail_welcome_board",
    "type": "board",
    "from": {
      "kind": "board",
      "name_ko": "이사회 의장 (가상)"
    },
    "subject_ko": "{player.firm} 트리티 헤드 부임을 환영합니다",
    "body_ko": [
      "{player.firm}의 트리티 플레이스먼트 헤드를 맡아 주셔서 감사합니다.",
      "앞으로 6주는 첫 갱신 시즌(1/1)을 준비하는 프리시즌입니다. 매주 상단의 Continue 버튼으로 한 주씩 넘기며 메일을 읽고 답해 주세요.",
      "답장에는 '행동 점수'가 듭니다. 점수는 매주 6점이 새로 채워지고, 남은 점수는 다음 주로 넘어가지 않습니다.",
      "지금 시장은 '{market.label}' 쪽입니다. 중개사에게는 가격 협상이 쉽지 않은 시기입니다."
    ],
    "priority": "normal",
    "blocking": false,
    "schedule": {
      "turn": 1
    },
    "choices": []
  },
  {
    "id": "mail_kickoff_jurong",
    "type": "client_request",
    "from": {
      "kind": "client",
      "name_ko": "주롱 크레스트 손해보험 CRO (가상)"
