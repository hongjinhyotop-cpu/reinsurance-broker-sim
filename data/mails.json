      },
      {
        "id": "skip",
        "label_ko": "이번에는 리포트만 읽고 넘어간다",
        "ap_cost": 0,
        "effects": [],
        "result_ko": "리포트만 확인하고 넘어갔습니다."
      }
    ]
  },
  {
    "id": "mail_compliance_notice",
    "type": "regulatory",
    "from": {
      "kind": "regulator",
      "name_ko": "금융감독당국 감독부 (가상)"
