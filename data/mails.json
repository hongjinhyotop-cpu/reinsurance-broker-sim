    "choices": [
      {
        "id": "prep",
        "label_ko": "지난 3년 손해 자료부터 꼼꼼히 정리하겠다고 답한다",
        "ap_cost": 2,
        "effects": [
          {
            "op": "add",
            "target": "player",
            "field": "reputation",
            "value": 2
          }
        ],
        "result_ko": "고객이 준비 방식에 만족했습니다. 평판이 조금 올랐습니다."
      },
      {
        "id": "later",
        "label_ko": "곧 일정을 잡아 다시 연락하겠다고만 답한다",
        "ap_cost": 0,
        "effects": [],
        "result_ko": "무난한 답장이었습니다. 고객은 다음 연락을 기다립니다."
      }
    ]
  },
  {
